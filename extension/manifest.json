{
  "manifest_version": 2,
  "name": "fftabs",
  "version": "0.1.0",
  "description": "Lets the local fftabs CLI list and switch tabs through a native messaging host. Nothing leaves your machine.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fftabs@laperex",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "nativeMessaging", "contextualIdentities", "history"],
  "background": {
    "scripts": ["background.js"]
  }
}
