/**
 * vscode.rasi — Rofi theme mimicking the VS Code Quick Open palette
 * Compatible with fftabs and rofi -dmenu
 */

configuration {
    show-icons:                 true;
}

* {
    font:                       "Cantarell, sans-serif 11";

    bg-window:                  #1f1f1f;
    bg-input:                   #2a2a2a;
    bg-selected:                #04395e;

    border-window:              #3c3c3c;
    border-input:               #0078d4;
    border-separator:           #2d2d2d;

    fg-primary:                 #cccccc;
    fg-selected:                #ffffff;
    fg-muted:                   #858585;
    fg-match:                   #75beff;
    fg-active:                  #89d185;

    background-color:           transparent;
    text-color:                 @fg-primary;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

window {
    location:                   north;
    anchor:                     north;
    y-offset:                   8px;
    width:                      780px;

    background-color:           @bg-window;
    border:                     1px;
    border-color:               @border-window;
    border-radius:              6px;
}

mainbox {
    children:                   [ inputbar, listview, textbox-footer ];
}

inputbar {
    padding:                    8px;
    children:                   [ entry ];
}

entry {
    padding:                    6px 10px;
    background-color:           @bg-input;
    text-color:                 @fg-primary;
    placeholder:                "Type to search tabs...";
    placeholder-color:          @fg-muted;
    border:                     1px;
    border-color:               @border-input;
    border-radius:              3px;
    cursor:                     text;
}

listview {
    lines:                      14;
    dynamic:                    true;
    scrollbar:                  false;
    cycle:                      false;
    padding:                    4px 6px;
    spacing:                    2px;
}

element {
    padding:                    5px 8px;
    spacing:                    8px;
    border-radius:              3px;
    text-color:                 @fg-primary;
    cursor:                     pointer;
}

element selected.normal, element selected.active {
    background-color:           @bg-selected;
    text-color:                 @fg-selected;
}

element normal.active {
    text-color:                 @fg-active;
}

element-icon {
    size:                       1.2em;
    vertical-align:             0.5;
    text-color:                 inherit;
    cursor:                     inherit;
}

element-text {
    vertical-align:             0.5;
    markup:                     true;
    highlight:                  bold #75beff;
    text-color:                 inherit;
    cursor:                     inherit;
}

textbox-footer {
    expand:                     false;
    str:                        "<b>Enter</b> switch · <b>Alt+d</b> close tab";
    markup:                     true;
    padding:                    6px 12px;
    text-color:                 @fg-muted;
    font:                       "Cantarell, sans-serif 9.5";
    border:                     1px 0px 0px 0px;
    border-color:               @border-separator;
}
