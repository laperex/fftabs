#!/usr/bin/env python3
"""fftabs - list and switch Firefox tabs from the shell, with a rofi front-end.

    Firefox  <-- native messaging -->  fftabs host  <-- unix socket -->  fftabs CLI / rofi
    (extension/ answers tab queries)   (started by Firefox)              (this script)

Usage:  fftabs [rofi|list|switch|close|status|install|uninstall]   (default: rofi)
        fftabs rofi -- <extra rofi args>
"""
