def site_of(url: str) -> str:
    p = urllib.parse.urlparse(url)
    if p.scheme in ("http", "https") and p.hostname:
        return re.sub(r"^www\.", "", p.hostname)
    return truncate(url, 60)


def build_payload(tabs: list[dict], no_icons: bool) -> bytes:
    multi_win = len({(t.get("_profile_slug", t["_pid"]), t["window"]["id"]) for t in tabs}) > 1
    multi_profile = len({t.get("_profile_slug", t["_pid"]) for t in tabs}) > 1
    out = bytearray()
    for t in tabs:
        url = sanitize(t.get("url"))
        title = truncate(sanitize(t.get("title")) or url or "(untitled)", 90)
        site = site_of(url)
        tags = [] if site == title else [site]
        if t["current"]:
            tags.append("current")
        if t.get("pinned"):
            tags.append("pinned")
        if t.get("audible"):
            tags.append("audio")
        elif t.get("muted"):
            tags.append("muted")
        if t.get("discarded"):
            tags.append("unloaded")
        if t.get("container"):
            tags.append(sanitize(t["container"]["name"]))
        if t["window"].get("private"):
            tags.append("private")
        if multi_profile:
            prof_name = t.get("_profile_name", t["_pid"])
            if multi_win:
                tags.append(f"{prof_name}/win {t['window']['n']}")
            else:
                tags.append(prof_name)
        elif multi_win:
            tags.append(f"win {t['window']['n']}")
        row = "{}  <span alpha='55%' size='small'>{}</span>".format(
            html.escape(title, quote=False), html.escape(" \u00b7 ".join(tags), quote=False)
        )
        opts: list[str] = []
        if not no_icons:
            state, path = cached_icon(t.get("favIconUrl", ""))
            opts += ["icon", path if state == "hit" else FALLBACK_ICON]
        opts += ["meta", f"{title} {url} {(t.get('container') or {}).get('name', '')} {t.get('_profile_name', '')}"]
        out += row.encode() + b"\0" + "\x1f".join(opts).encode() + b"\n"
    return bytes(out)


def cmd_rofi(args, extra) -> int:
    if not shutil.which("rofi"):
        die("rofi not found in PATH")
    allow_net = not (args.no_fetch or os.environ.get("FFTABS_NO_FETCH"))
    sel = 1 if args.previous else 0
    while True:
        tabs = ordered(fetch_tabs(), args.sort)
        if getattr(args, "profile", None):
            slug = slugify(args.profile)
            tabs = [t for t in tabs if t["_profile_slug"] == slug
                    or t["_profile_name"].lower() == args.profile.lower()]
            if not tabs:
                die(f"no profile matching {args.profile!r}")
            for t in tabs:
                t["ref"] = str(t["id"])
        if not args.no_icons:
            prefetch_icons({t.get("favIconUrl", "") for t in tabs}, allow_net)
        cmd = [
            "rofi", "-dmenu", "-i", "-p", "tabs", "-markup-rows", "-no-custom",
            "-format", "i", "-kb-custom-1", "Alt+d",
            "-mesg", "<b>Enter</b> switch  \u00b7  <b>Alt+d</b> close tab",
        ]
        if not args.no_icons:
            cmd.append("-show-icons")
        if sel:
            cmd += ["-selected-row", str(min(sel, len(tabs) - 1))]
        res = subprocess.run(
            cmd + extra, input=build_payload(tabs, args.no_icons), stdout=subprocess.PIPE
        )
        try:
            idx = int(res.stdout.decode().strip())
            tab = tabs[idx]
        except (ValueError, IndexError):
            return 1  # cancelled (or rofi failed)
        path = Path(tab["_sock"])
        if res.returncode == 0:
            switch_to(path, tab["id"], firefox_pid=tab.get("_firefox_pid"))
            return 0
        if res.returncode == 10:  # Alt+d: close, then show the menu again
            close_tab(path, tab["id"])
            sel = idx
            continue
        return 1


def cmd_list(args, _extra) -> int:
    tabs = ordered(fetch_tabs(), args.sort)
    if getattr(args, "profile", None):
        slug = slugify(args.profile)
        tabs = [t for t in tabs if t["_profile_slug"] == slug
                or t["_profile_name"].lower() == args.profile.lower()]
        if not tabs:
            die(f"no profile matching {args.profile!r}")
        for t in tabs:
            t["ref"] = str(t["id"])
    if args.json:
        keep = []
        for t in tabs:
            d = {k: v for k, v in t.items() if not k.startswith("_")}
            d["profile"] = t.get("_profile_name", t["_pid"])
            d["profile_slug"] = t.get("_profile_slug", "")
            d["pid"] = int(t["_pid"]) if t["_pid"].isdigit() else t["_pid"]
            d["firefox_pid"] = t.get("_firefox_pid")
            keep.append(d)
        json.dump(keep, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return 0
    for t in tabs:  # ref <TAB> profile <TAB> window <TAB> current? <TAB> title <TAB> url
        print("\t".join([
            t["ref"], t.get("_profile_name", t["_pid"]), str(t["window"]["n"]),
            "*" if t["current"] else "-",
            sanitize(t["title"]), sanitize(t["url"]),
        ]))
    return 0


def cmd_switch(args, _extra) -> int:
    path, tid = resolve_ref(args.ref)
    switch_to(path, tid)
    return 0


def cmd_close(args, _extra) -> int:
    path, tid = resolve_ref(args.ref)
    close_tab(path, tid)
    return 0


def _wrapper_path() -> Path:
    return data_dir() / "fftabs-host"


def cmd_install(args, _extra) -> int:
    script = Path(__file__).resolve()
    wrapper = _wrapper_path()
    wrapper.parent.mkdir(parents=True, exist_ok=True)
    wrapper.write_text(
        "#!/bin/sh\nexec {} {} host\n".format(shlex.quote(sys.executable), shlex.quote(str(script)))
    )
    wrapper.chmod(0o755)
    mdir = Path(args.manifest_dir or DEFAULT_MANIFEST_DIR).expanduser()
    mdir.mkdir(parents=True, exist_ok=True)
    manifest = {
        "name": HOST_NAME,
        "description": "fftabs: lets the fftabs CLI list and switch Firefox tabs",
        "path": str(wrapper),
        "type": "stdio",
        "allowed_extensions": ALLOWED_EXTENSIONS,
    }
    (mdir / f"{HOST_NAME}.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(f"wrote {mdir / (HOST_NAME + '.json')}")
    print(f"wrote {wrapper}  ->  {script}")
    print("next: load extension/ in Firefox (see README), then run `fftabs status`")
    return 0


def cmd_uninstall(args, _extra) -> int:
    mdir = Path(args.manifest_dir or DEFAULT_MANIFEST_DIR).expanduser()
    for p in (mdir / f"{HOST_NAME}.json", _wrapper_path()):
        if p.exists():
            p.unlink()
            print(f"removed {p}")
    return 0


def cmd_status(args, _extra) -> int:
    mpath = Path(args.manifest_dir or DEFAULT_MANIFEST_DIR).expanduser() / f"{HOST_NAME}.json"
    print(f"native manifest : {'ok' if mpath.exists() else 'MISSING'}  ({mpath})")
    print(f"host wrapper    : {'ok' if _wrapper_path().exists() else 'MISSING'}  ({_wrapper_path()})")
    print(f"rofi            : {shutil.which('rofi') or 'MISSING'}")
    try:
        import PIL  # noqa: F401
        print("Pillow          : yes (ICO/WEBP favicons are converted to PNG)")
    except ImportError:
        print("Pillow          : no  (optional; python-pillow converts ICO/WEBP favicons)")
    print(f"compositor      : {_detect_backend() or 'unknown (set FFTABS_FOCUS_CMD to focus Firefox)'}")
    socks = sockets()
    if not socks:
        print("firefox         : NOT CONNECTED (extension not loaded, or Firefox not running)")
        return 1
    for p in socks:
        try:
            r = rpc(p, {"cmd": "ping"}, timeout=5)
            state = "ok" if r.get("ok") else f"error: {r.get('error')}"
            profile = (r.get("profile") or {}).get("name")
            if profile and r.get("ok"):
                state = f"ok  profile={profile}"
        except ConnectionRefusedError:
            p.unlink(missing_ok=True)
            continue
        except (OSError, ValueError) as e:
            state = f"error: {e}"
        print(f"firefox         : host pid {sock_pid(p)}  {state}")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    extra: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    if not argv:
        argv = ["rofi"]

    ap = argparse.ArgumentParser(prog="fftabs", description="List and switch Firefox tabs (rofi front-end).")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("rofi", help="pick a tab with rofi (default); args after -- go to rofi")
    p.add_argument("--sort", choices=["recent", "window"], default="recent")
    p.add_argument("--previous", action="store_true", help="preselect the previous tab (alt-tab style)")
    p.add_argument("--no-icons", action="store_true")
    p.add_argument("--no-fetch", action="store_true", help="never download favicons (cached/data: only)")
    p.add_argument("--profile", metavar="NAME", help="show only tabs from this profile")
    p.set_defaults(fn=cmd_rofi)

    p = sub.add_parser("list", help="print tabs (TSV: ref, profile, window, current, title, url)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--sort", choices=["recent", "window"], default="window")
    p.add_argument("--profile", metavar="NAME", help="show only tabs from this profile")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("switch", help="activate a tab and focus its window")
    p.add_argument("ref", help="ID, profile:ID, or PID:ID from `fftabs list`")
    p.set_defaults(fn=cmd_switch)

    p = sub.add_parser("close", help="close a tab")
    p.add_argument("ref", help="ID, profile:ID, or PID:ID from `fftabs list`")
    p.set_defaults(fn=cmd_close)

    for name, fn, text in (
        ("status", cmd_status, "check the whole chain"),
        ("install", cmd_install, "register the native messaging host with Firefox"),
        ("uninstall", cmd_uninstall, "remove the native messaging host registration"),
    ):
        p = sub.add_parser(name, help=text)
        p.add_argument("--manifest-dir", help=f"native-messaging-hosts dir (default {DEFAULT_MANIFEST_DIR})")
        p.set_defaults(fn=fn)

    p = sub.add_parser("host", help=argparse.SUPPRESS)  # started by Firefox, not by you
    p.set_defaults(fn=cmd_host)

    args = ap.parse_args(argv)
    return args.fn(args, extra)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
