def site_of(url: str) -> str:
    p = urllib.parse.urlparse(url)
    if p.scheme in ("http", "https") and p.hostname:
        return re.sub(r"^www\.", "", p.hostname)
    return truncate(url, 60)


def build_payload(tabs: list[dict], no_icons: bool) -> bytes:
    multi_win = len({(t.get("_profile_slug", t["_pid"]), t["window"]["id"]) for t in tabs}) > 1
    multi_profile = len({t.get("_profile_slug", t["_pid"]) for t in tabs}) > 1
    win_tab_counts: dict[tuple[str, int], int] = {}
    for t in tabs:
        wkey = (t.get("_profile_slug", t.get("_pid", "")), (t.get("window") or {}).get("id", 0))
        win_tab_counts[wkey] = win_tab_counts.get(wkey, 0) + 1

    out = bytearray()
    for t in tabs:
        url = sanitize(t.get("url"))
        title = truncate(sanitize(t.get("title")) or url or "(untitled)", 90)
        site = site_of(url)
        tags = [] if site == title else [site]
        if t["current"]:
            tags.append("current")
        if t.get("pinned"):
            tags.append("pinned")
        if t.get("audible"):
            tags.append("audio")
        elif t.get("muted"):
            tags.append("muted")
        if t.get("discarded"):
            tags.append("unloaded")
        if t.get("container"):
            tags.append(sanitize(t["container"]["name"]))
        if t["window"].get("private"):
            tags.append("private")

        wkey = (t.get("_profile_slug", t.get("_pid", "")), (t.get("window") or {}).get("id", 0))
        total_in_win = win_tab_counts.get(wkey, 1)
        pos_tag = f"#{t.get('index', 0) + 1}/{total_in_win}"

        if multi_profile:
            prof_name = t.get("_profile_name", t["_pid"])
            if multi_win:
                tags.append(f"{prof_name}/win {t['window']['n']} [{pos_tag}]")
            else:
                tags.append(f"{prof_name} [{pos_tag}]")
        elif multi_win:
            tags.append(f"win {t['window']['n']} [{pos_tag}]")
        else:
            tags.append(f"[{pos_tag}]")
        row = "{}  <span alpha='55%' size='small'>{}</span>".format(
            html.escape(title, quote=False), html.escape(" \u00b7 ".join(tags), quote=False)
        )
        opts: list[str] = []
        if not no_icons:
            state, path = cached_icon(t.get("favIconUrl", ""))
            opts += ["icon", path if state == "hit" else FALLBACK_ICON]
        opts += ["meta", f"{title} {url} {(t.get('container') or {}).get('name', '')} {t.get('_profile_name', '')}"]
        out += row.encode() + b"\0" + "\x1f".join(opts).encode() + b"\n"
    return bytes(out)


def cmd_rofi(args, extra) -> int:
    if not shutil.which("rofi"):
        die("rofi not found in PATH")
    allow_net = not (args.no_fetch or os.environ.get("FFTABS_NO_FETCH"))
    sel = 1 if args.previous else 0
    while True:
        tabs = ordered(fetch_tabs(), args.sort)
        if getattr(args, "profile", None):
            slug = slugify(args.profile)
            tabs = [t for t in tabs if t["_profile_slug"] == slug
                    or t["_profile_name"].lower() == args.profile.lower()]
            if not tabs:
                die(f"no profile matching {args.profile!r}")
            for t in tabs:
                t["ref"] = str(t["id"])
        if not tabs:
            die("no tabs open")
        if not args.no_icons:
            prefetch_icons({t.get("favIconUrl", "") for t in tabs}, allow_net)
        cmd = [
            "rofi", "-dmenu", "-i", "-p", "tabs", "-markup-rows", "-no-custom",
            "-format", "i",
            "-kb-custom-1", "Alt+d",
            "-kb-custom-2", "Alt+o",
            "-kb-custom-3", "Alt+r",
            "-kb-custom-4", "Alt+l",
            "-kb-custom-5", "Alt+n",
            "-mesg", "<b>Enter</b> switch · <b>Alt+d</b> close · <b>Alt+o</b> others · <b>Alt+r</b> right · <b>Alt+l</b> left · <b>Alt+n</b> new tab",
        ]
        if not args.no_icons:
            cmd.append("-show-icons")
        if sel:
            cmd += ["-selected-row", str(min(sel, len(tabs) - 1))]
        res = subprocess.run(
            cmd + extra, input=build_payload(tabs, args.no_icons), stdout=subprocess.PIPE
        )
        try:
            idx = int(res.stdout.decode().strip())
            tab = tabs[idx]
        except (ValueError, IndexError):
            return 1  # cancelled (or rofi failed)
        path = Path(tab["_sock"])
        if res.returncode == 0:
            switch_to(path, tab["id"], firefox_pid=tab.get("_firefox_pid"))
            return 0
        if res.returncode == 10:  # Alt+d: close, then show the menu again
            close_tab(path, tab["id"])
            sel = idx
            continue
        if res.returncode == 11:  # Alt+o: close others
            to_close = compute_scoped_tabs(tabs, tab, "others")
            if to_close and confirm_scoped_close(tab, to_close, "others"):
                execute_close_tabs(path, tab["id"], "others")
            sel = 0
            continue
        if res.returncode == 12:  # Alt+r: close right
            to_close = compute_scoped_tabs(tabs, tab, "right")
            if to_close and confirm_scoped_close(tab, to_close, "right"):
                execute_close_tabs(path, tab["id"], "right")
            sel = idx
            continue
        if res.returncode == 13:  # Alt+l: close left
            to_close = compute_scoped_tabs(tabs, tab, "left")
            if to_close and confirm_scoped_close(tab, to_close, "left"):
                execute_close_tabs(path, tab["id"], "left")
            sel = 0
            continue
        if res.returncode == 14:  # Alt+n: open new tab prompt
            ret = cmd_open_picker(args, extra)
            if ret == 0:
                return 0
            continue
        return 1


def cmd_list(args, _extra) -> int:
    tabs = ordered(fetch_tabs(), args.sort)
    if getattr(args, "profile", None):
        slug = slugify(args.profile)
        tabs = [t for t in tabs if t["_profile_slug"] == slug
                or t["_profile_name"].lower() == args.profile.lower()]
        if not tabs:
            die(f"no profile matching {args.profile!r}")
        for t in tabs:
            t["ref"] = str(t["id"])
    if args.json:
        keep = []
        for t in tabs:
            d = {k: v for k, v in t.items() if not k.startswith("_")}
            d["profile"] = t.get("_profile_name", t["_pid"])
            d["profile_slug"] = t.get("_profile_slug", "")
            d["pid"] = int(t["_pid"]) if t["_pid"].isdigit() else t["_pid"]
            d["firefox_pid"] = t.get("_firefox_pid")
            keep.append(d)
        json.dump(keep, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return 0
    for t in tabs:  # ref <TAB> profile <TAB> window <TAB> current? <TAB> title <TAB> url
        print("\t".join([
            t["ref"], t.get("_profile_name", t["_pid"]), str(t["window"]["n"]),
            "*" if t["current"] else "-",
            sanitize(t["title"]), sanitize(t["url"]),
        ]))
    return 0


def cmd_switch(args, _extra) -> int:
    path, tid = resolve_ref(args.ref)
    switch_to(path, tid)
    return 0


def cmd_close(args, _extra) -> int:
    path, tid = resolve_ref(args.ref)
    scope = "target"
    if getattr(args, "others", False):
        scope = "others"
    elif getattr(args, "right", False):
        scope = "right"
    elif getattr(args, "left", False):
        scope = "left"

    if scope == "target":
        close_tab(path, tid)
        return 0

    tabs = fetch_tabs()
    target = next((t for t in tabs if t["id"] == tid and str(Path(t.get("_sock", ""))) == str(path)), None)
    if not target:
        target = next((t for t in tabs if t["id"] == tid), None)
    if not target:
        die(f"tab with ID {tid} not found")

    keep_pinned = not getattr(args, "close_pinned", False)
    to_close = compute_scoped_tabs(tabs, target, scope, keep_pinned=keep_pinned)
    if not to_close:
        print("No tabs matching scope to close.")
        return 0

    if not getattr(args, "yes", False):
        count = len(to_close)
        scope_labels = {"others": "other tabs", "right": "tabs to the right", "left": "tabs to the left"}
        print(f"Closing {count} {scope_labels.get(scope, scope)} in window {target['window']['n']}:")
        for t in to_close[:10]:
            print(f"  - [{t['ref']}] {truncate(sanitize(t.get('title')), 60)}")
        if count > 10:
            print(f"  ... and {count - 10} more")
        try:
            resp = input("Proceed? [y/N]: ").strip().lower()
            if resp != "y":
                print("Cancelled.")
                return 1
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return 1

    closed = execute_close_tabs(path, tid, scope, keep_pinned=keep_pinned)
    print(f"Closed {closed} tab(s).")
    return 0


def cmd_close_others(args, extra) -> int:
    args.others = True
    args.right = False
    args.left = False
    return cmd_close(args, extra)


def cmd_close_right(args, extra) -> int:
    args.others = False
    args.right = True
    args.left = False
    return cmd_close(args, extra)


def cmd_close_left(args, extra) -> int:
    args.others = False
    args.right = False
    args.left = True
    return cmd_close(args, extra)


def cmd_open(args, extra) -> int:
    query = getattr(args, "query", None)
    if query:
        target_sock, target_win = get_target_window(getattr(args, "profile", None))
        open_tab(query, sock_path=target_sock, window_id=target_win.get("id"))
        return 0
    return cmd_open_picker(args, extra)


def _wrapper_path() -> Path:
    return data_dir() / "fftabs-host"


def cmd_install(args, _extra) -> int:
    script = Path(__file__).resolve()
    wrapper = _wrapper_path()
    wrapper.parent.mkdir(parents=True, exist_ok=True)
    wrapper.write_text(
        "#!/bin/sh\nexec {} {} host\n".format(shlex.quote(sys.executable), shlex.quote(str(script)))
    )
    wrapper.chmod(0o755)
    mdir = Path(args.manifest_dir or DEFAULT_MANIFEST_DIR).expanduser()
    mdir.mkdir(parents=True, exist_ok=True)
    manifest = {
        "name": HOST_NAME,
        "description": "fftabs: lets the fftabs CLI list and switch Firefox tabs",
        "path": str(wrapper),
        "type": "stdio",
        "allowed_extensions": ALLOWED_EXTENSIONS,
    }
    (mdir / f"{HOST_NAME}.json").write_text(json.dumps(manifest, indent=2) + "\n")
    print(f"wrote {mdir / (HOST_NAME + '.json')}")
    print(f"wrote {wrapper}  ->  {script}")
    print("next: load extension/ in Firefox (see README), then run `fftabs status`")
    return 0


def cmd_uninstall(args, _extra) -> int:
    mdir = Path(args.manifest_dir or DEFAULT_MANIFEST_DIR).expanduser()
    for p in (mdir / f"{HOST_NAME}.json", _wrapper_path()):
        if p.exists():
            p.unlink()
            print(f"removed {p}")
    return 0


def cmd_status(args, _extra) -> int:
    mpath = Path(args.manifest_dir or DEFAULT_MANIFEST_DIR).expanduser() / f"{HOST_NAME}.json"
    print(f"native manifest : {'ok' if mpath.exists() else 'MISSING'}  ({mpath})")
    print(f"host wrapper    : {'ok' if _wrapper_path().exists() else 'MISSING'}  ({_wrapper_path()})")
    print(f"rofi            : {shutil.which('rofi') or 'MISSING'}")
    try:
        import PIL  # noqa: F401
        print("Pillow          : yes (ICO/WEBP favicons are converted to PNG)")
    except ImportError:
        print("Pillow          : no  (optional; python-pillow converts ICO/WEBP favicons)")
    print(f"compositor      : {_detect_backend() or 'unknown (set FFTABS_FOCUS_CMD to focus Firefox)'}")
    socks = sockets()
    if not socks:
        print("firefox         : NOT CONNECTED (extension not loaded, or Firefox not running)")
        return 1
    seen_keys: set[str] = set()
    for p in socks:
        try:
            r = rpc(p, {"cmd": "ping"}, timeout=5)
            state = "ok" if r.get("ok") else f"error: {r.get('error')}"
            prof = (r if isinstance(r, dict) else {}).get("profile") or {}
            profile = prof.get("name")
            prof_key = profile_instance_key(prof)
            is_dup = prof_key in seen_keys
            seen_keys.add(prof_key)
            if profile and r.get("ok"):
                dup_note = " (duplicate connection)" if is_dup else ""
                state = f"ok  profile={profile}{dup_note}"
        except ConnectionRefusedError:
            p.unlink(missing_ok=True)
            continue
        except (OSError, ValueError) as e:
            state = f"error: {e}"
        print(f"firefox         : host pid {sock_pid(p)}  {state}")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    extra: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    if not argv:
        argv = ["rofi"]

    ap = argparse.ArgumentParser(prog="fftabs", description="List and switch Firefox tabs (rofi front-end).")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("rofi", help="pick a tab with rofi (default); args after -- go to rofi")
    p.add_argument("--sort", choices=SORT_CHOICES, default="window-recent",
                   help="sort order: window-recent (default: MRU window first + tab MRU inside), "
                        "recent (pure tab MRU), window-index (MRU window + tab index), "
                        "window-num (static window order)")
    p.add_argument("--previous", action="store_true", help="preselect the previous tab (alt-tab style)")
    p.add_argument("--no-icons", action="store_true")
    p.add_argument("--no-fetch", action="store_true", help="never download favicons (cached/data: only)")
    p.add_argument("--profile", metavar="NAME", help="show only tabs from this profile")
    p.set_defaults(fn=cmd_rofi)

    p = sub.add_parser("list", help="print tabs (TSV: ref, profile, window, current, title, url)")
    p.add_argument("--json", action="store_true")
    p.add_argument("--sort", choices=SORT_CHOICES, default="window-recent",
                   help="sort order: window-recent (default), recent, window-index, window-num")
    p.add_argument("--profile", metavar="NAME", help="show only tabs from this profile")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("switch", help="activate a tab and focus its window")
    p.add_argument("ref", help="ID, profile:ID, or PID:ID from `fftabs list`")
    p.set_defaults(fn=cmd_switch)

    p = sub.add_parser("close", help="close a tab (or scoped tabs in window)")
    p.add_argument("ref", help="ID, profile:ID, or PID:ID from `fftabs list`")
    p.add_argument("--others", action="store_true", help="close other tabs in the same window")
    p.add_argument("--right", action="store_true", help="close tabs to the right in the same window")
    p.add_argument("--left", action="store_true", help="close tabs to the left in the same window")
    p.add_argument("-y", "--yes", action="store_true", help="skip confirmation prompt")
    p.add_argument("--close-pinned", action="store_true", help="also close pinned tabs")
    p.set_defaults(fn=cmd_close)

    for cname, cfn, cdesc in (
        ("close-others", cmd_close_others, "close other tabs in the same window"),
        ("close-right", cmd_close_right, "close tabs to the right in the same window"),
        ("close-left", cmd_close_left, "close tabs to the left in the same window"),
    ):
        p = sub.add_parser(cname, help=cdesc)
        p.add_argument("ref", help="ID, profile:ID, or PID:ID from `fftabs list`")
        p.add_argument("-y", "--yes", action="store_true", help="skip confirmation prompt")
        p.add_argument("--close-pinned", action="store_true", help="also close pinned tabs")
        p.set_defaults(fn=cfn)

    for oname in ("open", "new"):
        p = sub.add_parser(oname, help="open a URL or DuckDuckGo search in Firefox")
        p.add_argument("query", nargs="?", help="URL or search query (if omitted, opens rofi picker)")
        p.add_argument("--profile", metavar="NAME", help="target this profile")
        p.add_argument("--no-icons", action="store_true")
        p.add_argument("--no-fetch", action="store_true")
        p.set_defaults(fn=cmd_open)

    for name, fn, text in (
        ("status", cmd_status, "check the whole chain"),
        ("install", cmd_install, "register the native messaging host with Firefox"),
        ("uninstall", cmd_uninstall, "remove the native messaging host registration"),
    ):
        p = sub.add_parser(name, help=text)
        p.add_argument("--manifest-dir", help=f"native-messaging-hosts dir (default {DEFAULT_MANIFEST_DIR})")
        p.set_defaults(fn=fn)

    p = sub.add_parser("host", help=argparse.SUPPRESS)  # started by Firefox, not by you
    p.set_defaults(fn=cmd_host)

    args = ap.parse_args(argv)
    return args.fn(args, extra)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
