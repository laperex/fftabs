# ----------------------------------------------------------------------------
# paths / small helpers
# ----------------------------------------------------------------------------

def _xdg(var: str, default: str) -> Path:
    return Path(os.environ.get(var) or Path.home() / default)


def cache_dir() -> Path:
    return _xdg("XDG_CACHE_HOME", ".cache") / "fftabs"


def data_dir() -> Path:
    return _xdg("XDG_DATA_HOME", ".local/share") / "fftabs"


def runtime_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base and os.path.isdir(base):
        return Path(base)
    d = Path(f"/tmp/fftabs-{os.getuid()}")
    d.mkdir(mode=0o700, exist_ok=True)
    if d.stat().st_uid != os.getuid():
        raise SystemExit(f"fftabs: {d} belongs to another user")
    return d


def die(msg: str, code: int = 1):
    print(f"fftabs: {msg}", file=sys.stderr)
    raise SystemExit(code)


def warn(msg: str) -> None:
    print(f"fftabs: {msg}", file=sys.stderr)


def sanitize(s: str | None) -> str:
    """Single-line text with no control characters (rofi rows are NL/NUL/US delimited)."""
    return re.sub(r"[\x00-\x1f\x7f]+", " ", s or "").strip()


def truncate(s: str, n: int) -> str:
    return s if len(s) <= n else s[: n - 1] + "\u2026"


def log(msg: str) -> None:
    try:
        d = cache_dir()
        d.mkdir(parents=True, exist_ok=True)
        p = d / "host.log"
        if p.exists() and p.stat().st_size > 100_000:
            p.write_text("")
        with p.open("a") as f:
            f.write(f"{time.strftime('%F %T')} [{os.getpid()}] {msg}\n")
    except OSError:
        pass


# ----------------------------------------------------------------------------
# profile detection (host side, no extension round-trip)
# ----------------------------------------------------------------------------

def slugify(name: str) -> str:
    """Profile name -> lowercase slug for use in refs."""
    s = re.sub(r"[^a-z0-9_-]+", "-", name.lower())
    return s.strip("-") or "unknown"


def _find_parentlock(ppid: int) -> Path | None:
    """Scan /proc/<ppid>/fd for a symlink to */.parentlock or places.sqlite."""
    fd_dir = Path(f"/proc/{ppid}/fd")
    try:
        for entry in fd_dir.iterdir():
            try:
                target = entry.resolve(strict=False)
                if target.name in (".parentlock", "places.sqlite"):
                    return target.parent
            except OSError:
                continue
    except OSError:
        pass
    return None


def _query_profile_groups_db(firefox_dir: Path, profile_dirname: str) -> str | None:
    """Look up profile name in Firefox's Profile Groups sqlite DB."""
    pg_dir = firefox_dir / "Profile Groups"
    if not pg_dir.is_dir():
        return None
    for db_path in pg_dir.glob("*.sqlite"):
        try:
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1)
            try:
                row = con.execute(
                    "SELECT name FROM Profiles WHERE path = ?", (profile_dirname,)
                ).fetchone()
                if row and row[0]:
                    return row[0]
            finally:
                con.close()
        except Exception:
            continue
    return None


def _parse_profiles_ini(firefox_dir: Path, profile_dirname: str) -> str | None:
    """Look up profile name in profiles.ini by matching Path."""
    ini_path = firefox_dir / "profiles.ini"
    if not ini_path.is_file():
        return None
    cp = configparser.RawConfigParser()
    try:
        cp.read(str(ini_path), encoding="utf-8")
    except Exception:
        return None
    for sec in cp.sections():
        if not sec.lower().startswith("profile"):
            continue
        path = cp.get(sec, "Path", fallback=None)
        if not path:
            continue
        if cp.get(sec, "IsRelative", fallback="1") == "1":
            target_match = (path == profile_dirname)
        else:
            resolved = str(Path(path).resolve())
            prof_resolved = str((firefox_dir / profile_dirname).resolve())
            target_match = (resolved == prof_resolved)
        if target_match:
            return cp.get(sec, "Name", fallback=None)
    return None


def _profile_from_cmdline(ppid: int) -> str | None:
    """Parse /proc/<ppid>/cmdline for -P name, --profile path, -profile path."""
    try:
        raw = Path(f"/proc/{ppid}/cmdline").read_bytes()
    except OSError:
        return None
    args = raw.rstrip(b"\x00").split(b"\x00")
    args = [a.decode("utf-8", "replace") for a in args]
    for i, a in enumerate(args):
        if a in ("--profile", "-profile") and i + 1 < len(args):
            return Path(args[i + 1]).name
        if a == "-P" and i + 1 < len(args):
            return args[i + 1]
    return None


def detect_profile(ppid: int | None = None) -> dict:
    """Detect which Firefox profile this host belongs to. Returns
    {"name": str, "path": str|None, "firefox_pid": int}."""
    if ppid is None:
        try:
            ppid = int(os.environ.get("FFTABS_FIREFOX_PID") or os.getppid())
        except (ValueError, TypeError):
            ppid = os.getppid()
    info: dict = {"name": str(ppid), "path": None, "firefox_pid": ppid}

    # Step 1: find profile dir via /proc/ppid/fd -> .parentlock or places.sqlite
    profile_dir = _find_parentlock(ppid)
    if profile_dir:
        info["path"] = profile_dir.name
        firefox_dir = profile_dir.parent

        # Step 2a: Profile Groups DB (Firefox >= 140)
        name = _query_profile_groups_db(firefox_dir, profile_dir.name)
        if name:
            info["name"] = name
            return info

        # Step 2b: profiles.ini
        name = _parse_profiles_ini(firefox_dir, profile_dir.name)
        if name:
            info["name"] = name
            return info

    # Step 3: cmdline
    name = _profile_from_cmdline(ppid)
    if name:
        info["name"] = name
        return info

    # Step 4: directory basename (if we found it)
    if profile_dir:
        info["name"] = profile_dir.name
        return info

    # Step 5: PID as name (last resort)
    return info


def profile_instance_key(prof: dict) -> str:
    """Stable unique key for a running Firefox profile instance."""
    path = prof.get("path")
    fpid = prof.get("firefox_pid")
    name = prof.get("name") or "unknown"
    if path:
        return f"path:{path}"
    if fpid:
        return f"pid:{fpid}:{name}"
    return f"name:{name}"



# ----------------------------------------------------------------------------
# native messaging host (started by Firefox; NEVER print to stdout in here)
# ----------------------------------------------------------------------------

class Host:
    def __init__(self) -> None:
        self.sock_path = runtime_dir() / f"fftabs-{os.getpid()}.sock"
        self.out_lock = threading.Lock()
        self.pending_lock = threading.Lock()
        self.pending: dict[int, dict] = {}
        self.next_id = 1
        self.profile = detect_profile()
        log(f"host profile: {self.profile}")

    # -- browser side --------------------------------------------------------
    def send_native(self, obj: dict) -> None:
        data = json.dumps(obj, separators=(",", ":")).encode()
        with self.out_lock:
            sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
            sys.stdout.buffer.flush()

    def read_native(self) -> None:
        stdin = sys.stdin.buffer
        while True:
            hdr = stdin.read(4)
            if len(hdr) < 4:
                break
            (n,) = struct.unpack("=I", hdr)
            body = stdin.read(n)
            if len(body) < n:
                break
            try:
                msg = json.loads(body)
            except ValueError:
                continue
            with self.pending_lock:
                slot = self.pending.get(msg.get("id"))
            if slot:
                slot["reply"] = msg
                slot["event"].set()
        self.shutdown()  # Firefox closed the pipe

    def call_extension(self, req: dict, timeout: float = 8.0) -> dict:
        slot = {"event": threading.Event(), "reply": None}
        with self.pending_lock:
            rid = self.next_id
            self.next_id += 1
            self.pending[rid] = slot
        try:
            self.send_native({**req, "id": rid})
            if not slot["event"].wait(timeout):
                return {"ok": False, "error": "timed out waiting for Firefox"}
            return slot["reply"]
        finally:
            with self.pending_lock:
                self.pending.pop(rid, None)

    # -- CLI side ------------------------------------------------------------
    def handle_client(self, conn: socket.socket) -> None:
        with conn:
            conn.settimeout(10)
            buf = b""
            try:
                while b"\n" not in buf and len(buf) < 65536:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    buf += chunk
                req = json.loads(buf.split(b"\n", 1)[0] or b"null")
                if not isinstance(req, dict):
                    raise ValueError("request must be an object")
            except (ValueError, OSError):
                reply = {"ok": False, "error": "bad request"}
            else:
                reply = self.call_extension(req)
            if isinstance(reply, dict):
                reply["profile"] = self.profile
            try:
                conn.sendall(json.dumps(reply).encode() + b"\n")
            except OSError:
                pass

    def shutdown(self) -> None:
        try:
            self.sock_path.unlink()
        except OSError:
            pass
        log("host exiting")
        os._exit(0)

    def run(self) -> None:
        os.umask(0o077)
        try:
            self.sock_path.unlink()
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(str(self.sock_path))
        srv.listen(8)
        log(f"host started, socket {self.sock_path}")
        signal.signal(signal.SIGTERM, lambda *_: self.shutdown())
        threading.Thread(target=self.read_native, daemon=True).start()
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=self.handle_client, args=(conn,), daemon=True).start()


def cmd_host(_args, _extra) -> int:
    Host().run()
    return 0


# ----------------------------------------------------------------------------
# talking to the host(s)
# ----------------------------------------------------------------------------

def sockets() -> list[Path]:
    return sorted(runtime_dir().glob("fftabs-*.sock"))


def sock_pid(p: Path) -> str:
    m = re.fullmatch(r"fftabs-(\d+)\.sock", p.name)
    return m.group(1) if m else "?"


def rpc(path: Path, req: dict, timeout: float = 10.0) -> dict:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(str(path))
        s.sendall(json.dumps(req).encode() + b"\n")
        buf = bytearray()
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf)
    finally:
        s.close()


def fetch_tabs() -> list[dict]:
    tabs: list[dict] = []
    live: list[tuple[Path, dict]] = []
    seen_profiles: set[str] = set()
    seen_tabs: set[tuple[str, int]] = set()

    for p in sockets():
        try:
            r = rpc(p, {"cmd": "list"})
        except ConnectionRefusedError:
            p.unlink(missing_ok=True)  # stale socket from a crashed host
            continue
        except (OSError, ValueError) as e:
            warn(f"{p.name}: {e}")
            continue
        if not r.get("ok"):
            warn(f"{p.name}: {r.get('error', 'unknown error')}")
            continue
        profile = r.get("profile") or {}
        profile_name = profile.get("name") or sock_pid(p)
        firefox_pid = profile.get("firefox_pid")
        profile_path = profile.get("path")
        prof_key = profile_instance_key(profile)

        # Ignore duplicate host connections for an already queried profile
        if prof_key in seen_profiles:
            continue
        seen_profiles.add(prof_key)

        live.append((p, {"name": profile_name, "path": profile_path, "firefox_pid": firefox_pid, "key": prof_key}))
        for t in r["result"]:
            tab_key = (prof_key, t["id"])
            if tab_key in seen_tabs:
                continue
            seen_tabs.add(tab_key)
            t["_sock"] = str(p)
            t["_pid"] = sock_pid(p)
            t["_profile_name"] = profile_name
            t["_profile_path"] = profile_path
            t["_firefox_pid"] = firefox_pid
            tabs.append(t)
    if not live:
        die("no Firefox connected (is the extension loaded? try `fftabs status`)")

    # Detect slug collision across distinct profiles
    slug_counts: dict[str, list[str]] = {}
    for p, prof in live:
        s = slugify(prof["name"])
        slug_counts.setdefault(s, []).append(sock_pid(p))

    multi_profile = len(live) > 1

    for t in tabs:
        s = slugify(t["_profile_name"])
        if len(slug_counts.get(s, [])) > 1:
            s = f"{s}-{t['_pid']}"
        t["_profile_slug"] = s
        t["current"] = bool(t["active"] and t["window"]["focused"])
        t["ref"] = f"{s}:{t['id']}" if multi_profile else str(t["id"])
    record_history(tabs)
    return tabs


SORT_CHOICES = ["window-recent", "window", "recent", "window-index", "window-num"]


def ordered(tabs: list[dict], mode: str) -> list[dict]:
    if not tabs:
        return []

    if mode == "recent":
        # Pure tab-level MRU across all windows and profiles
        return sorted(tabs, key=lambda t: (-(t.get("lastAccessed") or 0), t.get("index", 0)))

    if mode == "window-num":
        # Static window number ordering (win 1, win 2...), then tab index
        return sorted(tabs, key=lambda t: (t.get("_profile_slug", ""), (t.get("window") or {}).get("n", 0), t.get("index", 0)))

    # Window recency modes ("window-recent", "window", "window-index"):
    # Group tabs by window: (profile_slug, window_id)
    # Recency score per window: (is_currently_focused: int, max_last_accessed: int)
    win_recency: dict[tuple[str, int], tuple[int, int]] = {}
    for t in tabs:
        w = t.get("window") or {}
        win_key = (t.get("_profile_slug", ""), w.get("id", 0))
        is_foc = 1 if w.get("focused") else 0
        acc = t.get("lastAccessed") or 0
        if win_key not in win_recency:
            win_recency[win_key] = (is_foc, acc)
        else:
            prev_foc, prev_acc = win_recency[win_key]
            win_recency[win_key] = (max(prev_foc, is_foc), max(prev_acc, acc))

    if mode == "window-index":
        # Most recently viewed window first; within each window, tabs ordered by tab-bar position (index)
        return sorted(
            tabs,
            key=lambda t: (
                -win_recency[(t.get("_profile_slug", ""), (t.get("window") or {}).get("id", 0))][0],
                -win_recency[(t.get("_profile_slug", ""), (t.get("window") or {}).get("id", 0))][1],
                t.get("index", 0),
            ),
        )

    # Default ("window-recent" / "window"):
    # Most recently viewed window first; within each window, tabs ordered by MRU (lastAccessed), then index
    return sorted(
        tabs,
        key=lambda t: (
            -win_recency[(t.get("_profile_slug", ""), (t.get("window") or {}).get("id", 0))][0],
            -win_recency[(t.get("_profile_slug", ""), (t.get("window") or {}).get("id", 0))][1],
            -(t.get("lastAccessed") or 0),
            t.get("index", 0),
        ),
    )


def resolve_ref(ref: str) -> tuple[Path, int]:
    m = re.fullmatch(r"(?:([a-zA-Z0-9_.-]+):)?(\d+)", ref)
    if not m:
        die(f"bad tab reference {ref!r} (expected ID, profile:ID, or PID:ID — see `fftabs list`)")
    prefix, tid_str = m.group(1), m.group(2)
    tid = int(tid_str)
    socks = sockets()
    if not socks:
        die("no Firefox connected (try `fftabs status`)")

    # Bare ID: unambiguous if only one host is connected
    if prefix is None:
        if len(socks) == 1:
            return socks[0], tid
        # Check tabs across all connected hosts to see if tid is unique
        try:
            tabs = fetch_tabs()
        except SystemExit:
            die("no Firefox connected (try `fftabs status`)")
        matching = [t for t in tabs if t["id"] == tid]
        if len(matching) == 1:
            return Path(matching[0]["_sock"]), tid
        if len(matching) > 1:
            matching_profs = sorted({t["_profile_name"] for t in matching})
            die(f"tab ID {tid} is ambiguous (found in profiles: {', '.join(matching_profs)}); use profile:ID")
        die(f"no tab with ID {tid} found across connected profiles")

    # Check if prefix matches a host PID socket directly (e.g. 12345:ID)
    pid_path = runtime_dir() / f"fftabs-{prefix}.sock"
    if pid_path.exists():
        return pid_path, tid

    # Match prefix against connected hosts' profile names / slugs
    matched_socks = []
    seen_matched_keys = set()
    for p in socks:
        try:
            r = rpc(p, {"cmd": "ping"})
        except (OSError, ValueError):
            continue
        profile = (r if isinstance(r, dict) else {}).get("profile") or {}
        name = profile.get("name") or sock_pid(p)
        prof_key = profile_instance_key(profile)
        slug = slugify(name)
        pid = sock_pid(p)
        if prefix.lower() in (slug.lower(), f"{slug}-{pid}".lower(), name.lower()):
            if prof_key not in seen_matched_keys:
                seen_matched_keys.add(prof_key)
                matched_socks.append(p)

    if len(matched_socks) == 1:
        return matched_socks[0], tid
    if len(matched_socks) > 1:
        die(f"ambiguous profile {prefix!r}: matches {len(matched_socks)} distinct profiles; use PID:ID instead")
    die(f"no Firefox profile matching {prefix!r} (try `fftabs list`)")


def switch_to(path: Path, tab_id: int, firefox_pid: int | None = None) -> None:
    try:
        r = rpc(path, {"cmd": "switch", "tabId": tab_id})
    except (OSError, ValueError) as e:
        die(f"switch failed: {e}")
    if not r.get("ok"):
        die(f"switch failed: {r.get('error')}")
    pid = (r.get("profile") or {}).get("firefox_pid") or firefox_pid
    focus_firefox_window(sanitize((r.get("result") or {}).get("title")), firefox_pid=pid)


def close_tab(path: Path, tab_id: int) -> None:
    try:
        r = rpc(path, {"cmd": "close", "tabId": tab_id})
    except (OSError, ValueError) as e:
        die(f"close failed: {e}")
    if not r.get("ok"):
        die(f"close failed: {r.get('error')}")


def compute_scoped_tabs(tabs: list[dict], target_tab: dict, scope: str, keep_pinned: bool = True) -> list[dict]:
    target_id = target_tab["id"]
    target_win_id = (target_tab.get("window") or {}).get("id")
    target_idx = target_tab.get("index", 0)

    scoped = []
    for t in tabs:
        if (t.get("window") or {}).get("id") != target_win_id:
            continue
        if keep_pinned and t.get("pinned"):
            continue
        if scope == "others" and t["id"] != target_id:
            scoped.append(t)
        elif scope == "right" and t.get("index", 0) > target_idx:
            scoped.append(t)
        elif scope == "left" and t.get("index", 0) < target_idx:
            scoped.append(t)
    return scoped


def execute_close_tabs(path: Path, tab_id: int, scope: str, keep_pinned: bool = True) -> int:
    try:
        r = rpc(path, {"cmd": "close-tabs", "tabId": tab_id, "scope": scope, "keepPinned": keep_pinned})
        if r.get("ok"):
            return (r.get("result") or {}).get("closed", 1)
    except Exception:
        pass

    # Fallback for older extension without close-tabs support:
    try:
        r = rpc(path, {"cmd": "list"})
        if r.get("ok"):
            tabs = r.get("result") or []
            target = next((t for t in tabs if t["id"] == tab_id), None)
            if target:
                scoped = compute_scoped_tabs(tabs, target, scope, keep_pinned=keep_pinned)
                for t in scoped:
                    close_tab(path, t["id"])
                return len(scoped)
    except Exception:
        pass
    return 0


def confirm_scoped_close(target_tab: dict, to_close: list[dict], scope: str) -> bool:
    if not to_close:
        return False
    count = len(to_close)
    scope_labels = {
        "others": "other tabs",
        "right": "tabs to the right",
        "left": "tabs to the left",
    }
    label = scope_labels.get(scope, scope)
    summary_titles = ", ".join(truncate(sanitize(t.get("title")), 35) for t in to_close[:3])
    if count > 3:
        summary_titles += f", and {count - 3} more"

    w_n = target_tab.get("window", {}).get("n", 1)
    idx_display = target_tab.get("index", 0) + 1
    target_title = truncate(sanitize(target_tab.get("title")), 45)

    mesg = (
        f"Target: <b>{html.escape(target_title, quote=False)}</b> (win {w_n} [#{idx_display}])\n"
        f"Will close <b>{count}</b> {label}: {html.escape(summary_titles, quote=False)}"
    )
    options = [
        f"<b>Confirm</b>: Close {count} {label}",
        "Cancel",
    ]
    cmd = [
        "rofi", "-dmenu", "-i", "-p", f"close {count} tabs?", "-markup-rows", "-no-custom",
        "-format", "i", "-mesg", mesg,
    ]
    try:
        res = subprocess.run(cmd, input="\n".join(options).encode() + b"\n", stdout=subprocess.PIPE)
        if res.returncode == 0:
            choice = int(res.stdout.decode().strip())
            return choice == 0
    except Exception:
        return False
    return False


def history_file() -> Path:
    return cache_dir() / "history.json"


def record_history(tabs: list[dict]) -> None:
    p = history_file()
    entries: dict[str, dict] = {}
    if p.exists():
        try:
            for item in json.loads(p.read_text()):
                if isinstance(item, dict) and item.get("url"):
                    entries[item["url"]] = item
        except Exception:
            pass

    now = int(time.time() * 1000)
    for t in tabs:
        url = t.get("url")
        if not url or url.startswith("about:"):
            continue
        title = t.get("title") or url
        fav = t.get("favIconUrl") or ""
        entries[url] = {
            "url": url,
            "title": title,
            "favIconUrl": fav,
            "lastAccessed": t.get("lastAccessed") or now,
        }

    sorted_items = sorted(entries.values(), key=lambda x: -(x.get("lastAccessed") or 0))[:500]
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(json.dumps(sorted_items, indent=2))
    except OSError:
        pass


def fetch_combined_history(query: str = "") -> list[dict]:
    merged: dict[str, dict] = {}

    # Source 1: Local cache
    p = history_file()
    if p.exists():
        try:
            for item in json.loads(p.read_text()):
                u = item.get("url")
                if u:
                    merged[u] = {
                        "url": u,
                        "title": item.get("title") or u,
                        "favIconUrl": item.get("favIconUrl", ""),
                        "lastAccessed": item.get("lastAccessed", 0),
                    }
        except Exception:
            pass

    # Source 2: Firefox extension history API
    socks = sockets()
    for s in socks:
        try:
            r = rpc(s, {"cmd": "history", "query": query, "limit": 100})
            if r.get("ok"):
                for item in r.get("result", []):
                    u = item.get("url")
                    if not u or u.startswith("about:"):
                        continue
                    existing = merged.get(u)
                    acc = item.get("lastVisitTime") or 0
                    if not existing or acc > (existing.get("lastAccessed") or 0):
                        merged[u] = {
                            "url": u,
                            "title": item.get("title") or u,
                            "favIconUrl": existing.get("favIconUrl", "") if existing else "",
                            "lastAccessed": acc,
                        }
        except Exception:
            pass

    q = query.lower().strip()
    results = list(merged.values())
    if q:
        results = [r for r in results if q in r["title"].lower() or q in r["url"].lower()]

    results.sort(key=lambda x: -(x.get("lastAccessed") or 0))
    return results[:300]


def resolve_url_or_search(text: str) -> str:
    text = text.strip()
    if not text:
        return "about:newtab"
    if text.startswith(("http://", "https://", "about:", "file://")):
        return text
    if re.match(r"^(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}(?::\d+)?(?:/.*)?$", text) or re.match(r"^localhost(?::\d+)?(?:/.*)?$", text):
        return f"https://{text}"
    search_tmpl = os.environ.get("FFTABS_SEARCH_URL", "https://duckduckgo.com/?q={query}")
    return search_tmpl.format(query=urllib.parse.quote_plus(text))


def get_target_window(profile: str | None = None) -> tuple[Path, dict]:
    socks = sockets()
    if not socks:
        die("no Firefox connected (is the extension loaded? try `fftabs status`)")

    candidates: list[tuple[Path, dict, int, int]] = []
    for p in socks:
        try:
            r = rpc(p, {"cmd": "list"})
        except Exception:
            continue
        if not r.get("ok"):
            continue
        prof_info = r.get("profile") or {}
        p_name = prof_info.get("name") or sock_pid(p)
        p_slug = slugify(p_name)
        if profile and profile.lower() not in (p_slug.lower(), p_name.lower()):
            continue

        tabs = r.get("result") or []
        wins: dict[int, list[dict]] = {}
        win_objs: dict[int, dict] = {}
        for t in tabs:
            wid = (t.get("window") or {}).get("id")
            if wid:
                wins.setdefault(wid, []).append(t)
                win_objs[wid] = t["window"]

        for wid, wtabs in wins.items():
            w_obj = win_objs[wid]
            is_foc = 1 if w_obj.get("focused") else 0
            max_acc = max((t.get("lastAccessed") or 0 for t in wtabs), default=0)
            candidates.append((p, w_obj, is_foc, max_acc))

    if not candidates:
        if profile:
            die(f"no profile matching {profile!r} found")
        return socks[0], {"id": None}

    candidates.sort(key=lambda c: (-c[2], -c[3]))
    return candidates[0][0], candidates[0][1]


def open_tab(url: str, sock_path: Path | None = None, window_id: int | None = None) -> None:
    if sock_path is None or window_id is None:
        target_sock, target_win = get_target_window()
        sock_path = sock_path or target_sock
        window_id = window_id or target_win.get("id")

    resolved_url = resolve_url_or_search(url)
    try:
        r = rpc(sock_path, {"cmd": "new-tab", "url": resolved_url, "windowId": window_id})
    except (OSError, ValueError) as e:
        die(f"new-tab failed: {e}")
    if not r.get("ok"):
        die(f"new-tab failed: {r.get('error')}")

    focus_firefox_window("", firefox_pid=sock_pid(sock_path) if sock_path else None)


def cmd_open_picker(args, extra, prefill: str = "") -> int:
    if not shutil.which("rofi"):
        die("rofi not found in PATH")

    history = fetch_combined_history()
    allow_net = not (getattr(args, "no_fetch", False) or os.environ.get("FFTABS_NO_FETCH"))

    if not getattr(args, "no_icons", False):
        prefetch_icons({h.get("favIconUrl", "") for h in history[:30]}, allow_net)

    out = bytearray()
    for h in history:
        url = sanitize(h.get("url"))
        title = truncate(sanitize(h.get("title")) or url, 90)
        site = site_of(url)
        tag = site if site != title else ""
        row = html.escape(title, quote=False)
        if tag:
            row += f"  <span alpha='55%' size='small'>{html.escape(tag, quote=False)}</span>"

        opts: list[str] = []
        if not getattr(args, "no_icons", False):
            state, p = cached_icon(h.get("favIconUrl", ""))
            opts += ["icon", p if state == "hit" else FALLBACK_ICON]
        opts += ["meta", f"{title} {url}"]
        out += row.encode() + b"\0" + "\x1f".join(opts).encode() + b"\n"

    cmd = [
        "rofi", "-dmenu", "-i", "-p", "open / search", "-markup-rows",
        "-format", "i\\ts",
        "-mesg", "<b>Enter</b> open / search with DuckDuckGo",
    ]
    if not getattr(args, "no_icons", False):
        cmd.append("-show-icons")
    if prefill:
        cmd += ["-filter", prefill]

    res = subprocess.run(cmd + extra, input=bytes(out), stdout=subprocess.PIPE)
    if res.returncode != 0:
        return 1

    stdout_str = res.stdout.decode().strip()
    if not stdout_str:
        return 1

    parts = stdout_str.split("\t", 1)
    try:
        idx = int(parts[0])
    except ValueError:
        idx = -1

    typed_text = parts[1] if len(parts) > 1 else stdout_str

    if 0 <= idx < len(history):
        target_url = history[idx]["url"]
    else:
        target_url = resolve_url_or_search(typed_text)

    target_sock, target_win = get_target_window(getattr(args, "profile", None))
    open_tab(target_url, sock_path=target_sock, window_id=target_win.get("id"))
    return 0


# ----------------------------------------------------------------------------
# favicons -> files rofi can show
# ----------------------------------------------------------------------------

ICON_MAX_BYTES = 512 * 1024
HIT_TTL = 30 * 86400
MISS_TTL = 86400


def _icon_dir() -> Path:
    return cache_dir() / "icons"


def _icon_key(url: str) -> str:
    return hashlib.sha1(url.encode("utf-8", "replace")).hexdigest()


def _sniff(data: bytes) -> str | None:
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if data[:4] == b"\x00\x00\x01\x00":
        return "ico"
    if data[:6] in (b"GIF87a", b"GIF89a"):
        return "gif"
    if data[:3] == b"\xff\xd8\xff":
        return "jpg"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp"
    head = data[:2048].lower()
    if b"<svg" in head and b"<html" not in head:
        return "svg"
    return None  # e.g. an HTML 404 page served instead of an icon


def _to_png(data: bytes, ext: str) -> bytes | None:
    """ICO/WEBP -> PNG via Pillow when it is installed (gdk-pixbuf coverage is patchy)."""
    try:
        from PIL import Image

        im = Image.open(io.BytesIO(data))
        if ext == "ico":
            im.size = max(im.ico.sizes())
        out = io.BytesIO()
        im.convert("RGBA").save(out, "PNG")
        return out.getvalue()
    except Exception:
        return None


def _decode_data_uri(uri: str) -> bytes:
    head, _, payload = uri[5:].partition(",")
    if "base64" in head.split(";"):
        payload = urllib.parse.unquote(payload)
        payload += "=" * (-len(payload) % 4)
        return base64.b64decode(payload)
    return urllib.parse.unquote_to_bytes(payload)


def _store(key: str, ext: str, data: bytes) -> None:
    d = _icon_dir()
    d.mkdir(parents=True, exist_ok=True)
    for old in d.glob(key + ".*"):
        old.unlink(missing_ok=True)
    tmp = d / f".{key}.{os.getpid()}.{threading.get_ident()}.tmp"
    tmp.write_bytes(data)
    tmp.replace(d / f"{key}.{ext}")


def fetch_icon(url: str) -> None:
    key = _icon_key(url)
    data = None
    try:
        if url.startswith("data:"):
            data = _decode_data_uri(url)
        elif url.startswith(("http://", "https://")):
            req = urllib.request.Request(
                url, headers={"User-Agent": "Mozilla/5.0 (fftabs)", "Accept": "image/*,*/*;q=0.5"}
            )
            with urllib.request.urlopen(req, timeout=3) as r:
                data = r.read(ICON_MAX_BYTES + 1)
    except Exception:
        data = None
    if data is not None and len(data) > ICON_MAX_BYTES:
        data = None
    ext = _sniff(data) if data else None
    if ext in ("ico", "webp"):
        png = _to_png(data, ext)
        if png:
            data, ext = png, "png"
        elif ext == "webp":
            ext = None  # most gdk-pixbuf builds cannot load it
    try:
        _store(key, ext or "miss", data if ext else b"")
    except OSError:
        pass


def cached_icon(url: str) -> tuple[str, str | None]:
    """('hit', path) | ('miss', None) | ('none', None) = not cached / expired."""
    if not url:
        return "miss", None
    now = time.time()
    for p in _icon_dir().glob(_icon_key(url) + ".*"):
        age = now - p.stat().st_mtime
        if p.suffix == ".miss":
            return ("miss", None) if age < MISS_TTL else ("none", None)
        if age < HIT_TTL:
            return "hit", str(p)
    return "none", None


def prefetch_icons(urls: set[str], allow_network: bool, deadline: float = 2.5) -> None:
    todo = [
        u
        for u in urls
        if u
        and cached_icon(u)[0] == "none"
        and (u.startswith("data:") or (allow_network and u.startswith(("http://", "https://"))))
    ]
    if not todo:
        return
    sem = threading.Semaphore(12)

    def work(u: str) -> None:
        with sem:
            fetch_icon(u)

    threads = [threading.Thread(target=work, args=(u,), daemon=True) for u in todo]
    for t in threads:
        t.start()
    end = time.monotonic() + deadline
    for t in threads:
        t.join(max(0.0, end - time.monotonic()))


# ----------------------------------------------------------------------------
# putting the Firefox window in front (compositor side)
# ----------------------------------------------------------------------------

APP_RE = re.compile(
    os.environ.get("FFTABS_APP_RE", r"^(org\.mozilla\.)?(firefox|librewolf|floorp|waterfox|zen)([-.].*)?$"),
    re.I,
)


def _run(cmd: list[str]) -> str | None:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def _sway_windows() -> list[dict]:
    out = _run(["swaymsg", "-t", "get_tree", "-r"])
    if not out:
        return []
    found: list[dict] = []

    def walk(n: dict) -> None:
        kids = n.get("nodes", []) + n.get("floating_nodes", [])
        for c in kids:
            walk(c)
        if not kids and n.get("type") in ("con", "floating_con"):
            app = n.get("app_id") or (n.get("window_properties") or {}).get("class") or ""
            if app:
                found.append({"id": n["id"], "title": n.get("name") or "", "app": app, "pid": n.get("pid")})

    walk(json.loads(out))
    return found


def _hypr_windows() -> list[dict]:
    out = _run(["hyprctl", "clients", "-j"])
    if not out:
        return []
    return [
        {"id": c["address"], "title": c.get("title", ""), "app": c.get("class", ""), "pid": c.get("pid")}
        for c in json.loads(out)
    ]


def _niri_windows() -> list[dict]:
    out = _run(["niri", "msg", "--json", "windows"])
    if not out:
        return []
    return [
        {"id": w["id"], "title": w.get("title") or "", "app": w.get("app_id") or "", "pid": w.get("pid")}
        for w in json.loads(out)
    ]


BACKENDS = {
    "sway": (_sway_windows, lambda i: ["swaymsg", f"[con_id={i}] focus"]),
    "hyprland": (_hypr_windows, lambda i: ["hyprctl", "dispatch", "focuswindow", f"address:{i}"]),
    "niri": (_niri_windows, lambda i: ["niri", "msg", "action", "focus-window", "--id", str(i)]),
}


def _detect_backend() -> str | None:
    if os.environ.get("SWAYSOCK"):
        return "sway"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    if os.environ.get("NIRI_SOCKET"):
        return "niri"
    return None


def focus_firefox_window(title: str, firefox_pid: int | None = None) -> None:
    """Firefox cannot reliably raise itself on Wayland, so ask the compositor.

    One Firefox window -> focus it. Several -> focus the one whose title contains the
    tab title (Firefox titles windows after their active tab). When firefox_pid is provided,
    first filter compositor windows by PID to target the correct profile.
    FFTABS_FOCUS_CMD overrides everything (run through the shell, tab title in $FFTABS_TITLE);
    FFTABS_NO_FOCUS=1 skips.
    """
    if os.environ.get("FFTABS_NO_FOCUS"):
        return
    custom = os.environ.get("FFTABS_FOCUS_CMD")
    if custom:
        subprocess.run(custom, shell=True, env={**os.environ, "FFTABS_TITLE": title})
        return
    name = _detect_backend()
    if not name:
        return
    list_windows, focus_cmd = BACKENDS[name]
    deadline = time.monotonic() + 0.6  # window titles lag the tab switch slightly
    pick = None
    while True:
        all_wins = [w for w in list_windows() if APP_RE.search(w["app"])]
        wins = all_wins
        if firefox_pid is not None:
            pid_wins = [w for w in all_wins if w.get("pid") == firefox_pid]
            if pid_wins:
                wins = pid_wins
        if len(wins) == 1:
            pick = wins[0]
            break
        pick = next((w for w in wins if title and title in w["title"]), None)
        if pick or not wins or time.monotonic() > deadline:
            break
        time.sleep(0.07)
    if pick:
        _run(focus_cmd(pick["id"]))


